# ============================================================
# EcoCycle Haiti — Variables d'environnement
# Développement local : copier en .env et remplir les valeurs
# Railway : saisir chaque variable dans Variables du service
# ============================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=changez-moi-avec-une-valeur-aleatoire-longue-et-unique

# Hosts (séparés par virgule — mettre votre domaine Railway + custom domain)
ALLOWED_HOSTS=*.up.railway.app,ecocycle.ht
CSRF_TRUSTED_ORIGINS=https://votre-app.up.railway.app,https://ecocycle.ht
CORS_ALLOWED_ORIGINS=https://votre-app.up.railway.app,https://ecocycle.ht
FRONTEND_URL=https://votre-app.up.railway.app

# Base de données PostgreSQL (Railway l'injecte automatiquement via ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (Railway l'injecte automatiquement via ${{Redis.REDIS_URL}})
REDIS_URL=redis://default:password@host:6379

# Cloudinary (stockage media — photos déchets, avatars)
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret

# Resend (emails transactionnels)
RESEND_API_KEY=re_xxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@ecocycle.ht
RESEND_FROM_NAME=EcoCycle Haiti

# Admin
ADMIN_EMAIL=admin@ecocycle.ht

# Anthropic Claude AI (analyse photos déchets)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxx

# Firebase FCM (notifications push mobiles — optionnel)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_CREDENTIALS_B64=
